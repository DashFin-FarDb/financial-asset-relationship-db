FROM python:3.12-slim AS base

WORKDIR /app

COPY requirements-api.txt .
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements-api.txt \
    && groupadd -r appuser \
    && useradd -r -g appuser appuser \
    && mkdir -p /data \
    && chown -R appuser:appuser /data

ENV PYTHONPATH=/app
ENV PORT=8000


FROM base AS migration

ARG TARGETARCH

RUN target_arch="${TARGETARCH:-amd64}" \
    && case "$target_arch" in \
      amd64) \
        supabase_archive="supabase_2.114.0_linux_amd64.tar.gz"; \
        supabase_sha="f36a33ca867f1cce9ba5efa705863fdc545d1465d3719a721793ea67eb692c5a" ;; \
      arm64) \
        supabase_archive="supabase_2.114.0_linux_arm64.tar.gz"; \
        supabase_sha="7bf55ea89c8ae48a101a9856c1cef22da8e2019ddcd451499249033652cacefa" ;; \
      *) echo "unsupported migration image architecture: $target_arch" >&2; exit 1 ;; \
    esac \
    && curl --fail --silent --show-error --location \
      --proto '=https' --proto-redir '=https' --tlsv1.2 \
      --output /tmp/supabase.tar.gz \
      "https://github.com/supabase/cli/releases/download/v2.114.0/$supabase_archive" \
    && echo "$supabase_sha  /tmp/supabase.tar.gz" \
      | sha256sum -c - \
    && tar -xzf /tmp/supabase.tar.gz -C /usr/local/bin supabase \
    && test "$(supabase --version)" = "2.114.0" \
    && rm /tmp/supabase.tar.gz

ENV SUPABASE_HOME=/tmp/fardb-supabase-cli

COPY src/ ./src/
COPY api/ ./api/
COPY migrations/ ./migrations/
COPY scripts/__init__.py scripts/migrate_database.py scripts/postgresql_ledger.py \
    scripts/bootstrap_database_capability_roles.sql ./scripts/
COPY supabase/ ./supabase/

USER appuser

CMD ["python", "-m", "scripts.migrate_database"]


FROM base AS runtime

COPY src/ ./src/
COPY api/ ./api/
# Required only for the preserved SQLite compatibility path.
COPY migrations/ ./migrations/

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT}/api/health || exit 1

EXPOSE ${PORT}

USER appuser

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
